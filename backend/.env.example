# =====================================================================
# Volcengine Ark (Huoshan Engine) — LLM provider
# =====================================================================
# Get your API key from https://www.volcengine.com/product/ark
# Endpoint ID (model ID) looks like: ep-202xxxxxxx-xxxxx
ARK_API_KEY=
ARK_MODEL_ID=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TIMEOUT=60
ARK_MAX_RETRIES=2

# Set to 1 only if your Ark endpoint supports OpenAI-style `response_format`.
# Most Doubao endpoints do NOT — leave at 0; the parser tolerates fenced JSON.
ARK_USE_JSON_MODE=0

# Set to 1 to bypass the network and use built-in mock outputs.
# Useful for demos when the API key is not yet configured, or for offline
# development. The full DAG / trace / report UI still works end-to-end.
VOLC_MOCK=0

# =====================================================================
# Web search backend (pluggable). Leave blank to fall back to LLM-only
# collection — the system still works, just with less external grounding.
# =====================================================================
# Pick ONE of: tavily | serper | bing | none
SEARCH_PROVIDER=none
TAVILY_API_KEY=
SERPER_API_KEY=
BING_API_KEY=

# =====================================================================
# Server
# =====================================================================
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
DATA_DIR=./data

# =====================================================================
# Compliance
# =====================================================================
USER_AGENT=CompetitiveAnalysisAgent/1.0 (+https://example.com/contact)
RESPECT_ROBOTS=1
CRAWL_RATE_LIMIT_PER_HOST=1.0   # requests / second / host

# =====================================================================
# Agent behavior
# =====================================================================
MAX_QC_ITERATIONS=2              # max rework loops the QC agent can request
MIN_SOURCES_PER_COMPETITOR=3     # below this, QC will request rework
