# =====================================================================
# 火山方舟 Ark（火山引擎）—— LLM 提供方
# =====================================================================
# 从 https://www.volcengine.com/product/ark 获取你的 API Key
# Endpoint ID（模型 ID）形如：ep-202xxxxxxx-xxxxx
ARK_API_KEY=
ARK_MODEL_ID=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TIMEOUT=60
ARK_MAX_RETRIES=2

# 仅当你的 Ark endpoint 支持 OpenAI 风格的 `response_format` 时才置为 1。
# 大多数豆包 endpoint 并不支持——请保持 0；解析器能容忍被代码块包裹的 JSON。
ARK_USE_JSON_MODE=0

# 置为 1 可绕过网络、改用内置的 mock 输出。
# 适用于 API Key 尚未配置时的演示，或离线开发。
# 完整的 DAG / 追踪 / 报告界面仍可端到端运行。
VOLC_MOCK=0

# =====================================================================
# 网络搜索后端（可插拔）。留空则回退到仅 LLM 的采集
# ——系统仍可工作，只是外部佐证更少。
# =====================================================================
# 从以下之一中选一个：tavily | serper | bing | none
SEARCH_PROVIDER=none
TAVILY_API_KEY=
SERPER_API_KEY=
BING_API_KEY=

# =====================================================================
# 服务器
# =====================================================================
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
DATA_DIR=./data

# =====================================================================
# 合规
# =====================================================================
USER_AGENT=CompetitiveAnalysisAgent/1.0 (+https://example.com/contact)
RESPECT_ROBOTS=1
CRAWL_RATE_LIMIT_PER_HOST=1.0   # 请求数 / 秒 / 主机

# =====================================================================
# 智能体行为
# =====================================================================
MAX_QC_ITERATIONS=2              # QC 智能体可请求的最大返工循环次数
MIN_SOURCES_PER_COMPETITOR=3     # 低于此值，QC 将请求返工
COLLECTOR_CONCURRENCY=3          # 每竞品采集 / 分析的并行度（1 = 串行）
MIN_CONFIDENCE=0.55              # 低于此置信度的断言成为重新采集候选项
SELF_CONSISTENCY_SAMPLES=1       # 竞品识别的 N 样本多数投票（1 = 关闭）
ENABLE_CONFLICT_DETECTION=1      # 确定性的跨来源冲突标记
